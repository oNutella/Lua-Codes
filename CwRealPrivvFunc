-- ──────────────────────────────────────────────────────────────────────────
-- § 2  SHARED HELPERS
-- ──────────────────────────────────────────────────────────────────────────
local function toAssetId(raw)
	raw = raw:match("^%s*(.-)%s*$")
	if raw:match("^%d+$")              then return "rbxassetid://" .. raw end
	if raw:match("^rbxassetid://%d+$") then return raw end
	return nil
end

local function parseSize(raw)
	raw = raw:match("^%s*(.-)%s*$")
	local n = tonumber(raw)
	return (n and n >= 1) and math.floor(n) or nil
end

