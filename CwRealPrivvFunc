-- ──────────────────────────────────────────────────────────────────────────
-- § 5  DRAGGABLE MAINFRAME  (inlined from GuiResize.makeDraggable)
-- ──────────────────────────────────────────────────────────────────────────
do
	local dragging, dragInput, dragStart, startPos

	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging  = true
		dragStart = input.Position
		startPos  = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end)

	MainFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local d = input.Position - dragStart
			MainFrame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

-- ──────────────────────────────────────────────────────────────────────────
-- § 6  TITLE SHINE EFFECT  (inlined from ShineEffect LocalScript)
-- ──────────────────────────────────────────────────────────────────────────
do
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 50
	gradient.Parent   = TitleLabel
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.ImageColor3 = Color3.new(1, 1, 1)

	local GREY  = Color3.fromRGB(160, 160, 160)
	local WHITE = Color3.fromRGB(255, 255, 255)

	local function lerp(a, b, t)
		return Color3.new(a.R+(b.R-a.R)*t, a.G+(b.G-a.G)*t, a.B+(b.B-a.B)*t)
	end
	local function smooth(t) return t*t*(3-2*t) end
	local function makeSeq(base, shine)
		local m1f=lerp(base,shine,.15); local m1n=lerp(base,shine,.60)
		local m2f=lerp(base,shine,.08); local m2n=lerp(base,shine,.40)
		local p2 =lerp(base,shine,.70)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0.00,base),  ColorSequenceKeypoint.new(0.15,base),
			ColorSequenceKeypoint.new(0.22,m1f),   ColorSequenceKeypoint.new(0.35,m1n),
			ColorSequenceKeypoint.new(0.50,shine), ColorSequenceKeypoint.new(0.62,m1n),
			ColorSequenceKeypoint.new(0.72,m1f),   ColorSequenceKeypoint.new(0.78,base),
			ColorSequenceKeypoint.new(0.80,base),  ColorSequenceKeypoint.new(0.83,m2f),
			ColorSequenceKeypoint.new(0.88,m2n),   ColorSequenceKeypoint.new(0.93,p2),
			ColorSequenceKeypoint.new(0.97,m2f),   ColorSequenceKeypoint.new(1.00,base),
		})
	end

	local S0=1.8; local S1=-1.8; local ST=3.5; local PT=2.0; local SS=3.5
	local sweepT=0; local colorT=0; local colorDir=1
	local inPause=false; local pauseTimer=0
	local shinePhase="idle"; local shineT=-1

	RunService.Heartbeat:Connect(function(dt)
		if inPause then
			pauseTimer += dt
			if shinePhase=="idle" then shinePhase="shine2"; shineT=0 end
			if shinePhase=="shine2" or shinePhase=="shine3" then
				shineT += dt/SS
				if shineT >= 1 then
					shinePhase = shinePhase=="shine2" and "shine3" or "done"
					shineT = shinePhase~="done" and 0 or -1
				end
			end
			gradient.Offset = (shinePhase=="shine2" or shinePhase=="shine3")
				and Vector2.new(S0+(S1-S0)*shineT, 0)
				or  Vector2.new(S0, 0)
			if pauseTimer >= PT and shinePhase=="done" then
				inPause=false; pauseTimer=0; sweepT=0; shinePhase="idle"; shineT=-1
			end
			return
		end
		sweepT = sweepT + dt/ST
		colorT = math.clamp(colorT + colorDir*dt/ST, 0, 1)
		if sweepT >= 1 then sweepT=1; inPause=true; colorDir=-colorDir end
		gradient.Offset = Vector2.new(S0+(S1-S0)*sweepT, 0)
		gradient.Color  = makeSeq(lerp(GREY,WHITE,smooth(colorT)), lerp(WHITE,GREY,smooth(colorT)))
	end)
end

