Cursor.ScaleType              = Enum.ScaleType.Fit
Cursor.Visible                = false
Cursor.Parent                 = CursorGui

local COLOR_WHITE = Color3.fromRGB(255,255,255)
local COLOR_GREEN = Color3.fromRGB(0,255,0)
local COLOR_RED   = Color3.fromRGB(255,0,0)
local _lastTarget    = nil
local _lastTintColor = COLOR_WHITE
local Mouse = LocalPlayer:GetMouse()

local function cursorEnabled() return _cursorId ~= nil end

local function applyTrack()
	if not cursorEnabled() then
		UserInputService.MouseIconEnabled = true
		Cursor.Visible = false
		return
	end
	UserInputService.MouseIconEnabled = false
	Cursor.Image   = _cursorId
	Cursor.Visible = true
	if _sniperActive then Cursor.Position = UDim2.new(0.5,0,0.5,0) end
end

UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
	_sniperActive = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
	applyTrack()
end)

local _lastValidCursorId   = ""
local _lastValidCursorSize = "70"

CursorIDBox.FocusLost:Connect(function()
	local t = CursorIDBox.Text:match("^%s*(.-)%s*$")
	if t == "" then
		CursorIDBox.Text = _lastValidCursorId
		_cursorId = _lastValidCursorId ~= "" and toAssetId(_lastValidCursorId) or nil
	else
		local p = toAssetId(t)
		if p then
			_lastValidCursorId = p:match("%d+") or ""
			_cursorId          = p
			CursorIDBox.Text   = _lastValidCursorId
		else
			CursorIDBox.Text = _lastValidCursorId
			_cursorId = _lastValidCursorId ~= "" and toAssetId(_lastValidCursorId) or nil
		end
	end
	Cursor.Image = _cursorId or ""
	applyTrack()
end)

CursorSzBox.FocusLost:Connect(function()
	local s = parseSize(CursorSzBox.Text)
	if s then
		_cursorSize            = s
		_lastValidCursorSize   = tostring(s)
		Cursor.Size            = UDim2.new(0, s, 0, s)
	else
		CursorSzBox.Text = _lastValidCursorSize
	end
end)

-- PreRender: position + team-color tint
RunService.PreRender:Connect(function()
	if not cursorEnabled() then return end
	if not _sniperActive then
		Cursor.Position = UDim2.fromOffset(_mx, _my)
	end
	local Target = Mouse.Target
	if Target ~= _lastTarget then
		_lastTarget = Target
		local tint  = COLOR_WHITE
		if Target and Target.Parent then
			local Limb = Target.Parent:FindFirstChildOfClass("Humanoid")
			local Acc  = Target.Parent.Parent and Target.Parent.Parent:FindFirstChildOfClass("Humanoid")
			local p    = Limb and Players:GetPlayerFromCharacter(Target.Parent)
				or (Acc and Players:GetPlayerFromCharacter(Target.Parent.Parent))
			if p then tint = p.TeamColor == _myTeamColor and COLOR_GREEN or COLOR_RED end
		end
		if tint ~= _lastTintColor then _lastTintColor = tint; Cursor.ImageColor3 = tint end
	end
end)

-- Init cursor from whatever is currently in the textboxes
do
	local p = toAssetId(CursorIDBox.Text)
	if p then
		_cursorId = p; _lastValidCursorId = p:match("%d+") or ""
		CursorIDBox.Text = _lastValidCursorId; Cursor.Image = p
	end
	local s = parseSize(CursorSzBox.Text)
	if s then
		_cursorSize = s; _lastValidCursorSize = tostring(s)
		Cursor.Size = UDim2.new(0, s, 0, s)
	else
		CursorSzBox.Text = _lastValidCursorSize
	end
	applyTrack()
end

