-- ──────────────────────────────────────────────────────────────────────────
-- § 9  GUN SOUND ID OVERRIDE
-- ──────────────────────────────────────────────────────────────────────────
local GS_NAME = "ShootSound"
local gsData  = {}

local function gsId()     return toAssetId(GunSoundIDBox.Text) end
local function gsActive() return gsId() ~= nil end

local function gsRemove(s)
	local d=gsData[s]; if not d then return end
	pcall(function() d.conn:Disconnect() end)
	gsData[s]=nil
	if s and s.Parent then s.SoundId=d.orig end
end

local function gsApply(s)
	local id=gsId(); if not id then gsRemove(s); return end
	local d=gsData[s]
	if d then if s.SoundId~=id then s.SoundId=id end; return end
	local orig=s.SoundId; s.SoundId=id
	local conn=s:GetPropertyChangedSignal("SoundId"):Connect(function()
		local a=gsId(); if a and s.SoundId~=a then s.SoundId=a end
	end)
	gsData[s]={conn=conn,orig=orig}
end

local function gsHandle(s)
	if not s:IsA("Sound") or s.Name~=GS_NAME then return end
	if gsActive() then gsApply(s) else gsRemove(s) end
end

local function gsScan()
	for s in pairs(gsData) do gsHandle(s) end
	for _,d in ipairs(workspace:GetDescendants()) do gsHandle(d) end
end

workspace.DescendantAdded:Connect(function(i)
	if i:IsA("Sound") and i.Name==GS_NAME then task.defer(function() gsHandle(i) end) end
end)
workspace.DescendantRemoving:Connect(function(i)
	if not i:IsA("Sound") then return end
	local d=gsData[i]; if d then pcall(function() d.conn:Disconnect() end); gsData[i]=nil end
end)
LocalPlayer.CharacterAdded:Connect(function() task.wait(); gsScan() end)

local _gsLastId = ""
GunSoundIDBox.FocusLost:Connect(function()
	local t=GunSoundIDBox.Text:match("^%s*(.-)%s*$")
	if t=="" then GunSoundIDBox.Text=_gsLastId
	else
		local p=toAssetId(t)
		if p then _gsLastId=p:match("%d+") or ""; GunSoundIDBox.Text=_gsLastId
		else GunSoundIDBox.Text=_gsLastId end
	end
	gsScan()
end)

RunService.PreRender:Connect(function()
	if not gsActive() then return end
	local id=gsId(); if not id then return end
	for s,d in pairs(gsData) do
		if not s or not s.Parent then pcall(function() d.conn:Disconnect() end); gsData[s]=nil; continue end
		if s.SoundId~=id then s.SoundId=id end
	end
end)
gsScan()

-- ──────────────────────────────────────────────────────────────────────────
-- § 10  GUN VOLUME OVERRIDE
-- ──────────────────────────────────────────────────────────────────────────
local GV_NAMES = {ShootSound=true, SecondarySound=true}
local gvData   = {}

local function gvVol()    local n=tonumber(GunVolumeBox.Text); return n and math.clamp(n,0,10) or nil end
local function gvActive() return gvVol()~=nil end

local function gvRemove(s)
	local d=gvData[s]; if not d then return end
	pcall(function() d.conn:Disconnect() end)
	gvData[s]=nil
	if s and s.Parent then s.Volume=d.orig end
end

local function gvApply(s)
	local v=gvVol(); if not v then gvRemove(s); return end
	local d=gvData[s]
	if d then if s.Volume~=v then s.Volume=v end; return end
	local orig=s.Volume; s.Volume=v
	local conn=s:GetPropertyChangedSignal("Volume"):Connect(function()
		local a=gvVol(); if a and s.Volume~=a then s.Volume=a end
	end)
	gvData[s]={conn=conn,orig=orig}
end

local function gvHandle(s)
	if not s:IsA("Sound") or not GV_NAMES[s.Name] then return end
	if gvActive() then gvApply(s) else gvRemove(s) end
end

local function gvScan()
	for s in pairs(gvData) do gvHandle(s) end
	for _,d in ipairs(workspace:GetDescendants()) do gvHandle(d) end
end

workspace.DescendantAdded:Connect(function(i)
	if i:IsA("Sound") and GV_NAMES[i.Name] then task.defer(function() gvHandle(i) end) end
end)
workspace.DescendantRemoving:Connect(function(i)
	if not i:IsA("Sound") then return end
	local d=gvData[i]; if d then pcall(function() d.conn:Disconnect() end); gvData[i]=nil end
end)
LocalPlayer.CharacterAdded:Connect(function() task.wait(); gvScan() end)

local _gvLastVol = nil
GunVolumeBox.FocusLost:Connect(function()
	local t=GunVolumeBox.Text:match("^%s*(.-)%s*$")
	if t=="" then
		GunVolumeBox.Text = _gvLastVol~=nil and tostring(_gvLastVol) or ""
	else
		local n=tonumber(t)
		if n and n>=0 and n<=10 then _gvLastVol=n; GunVolumeBox.Text=tostring(n)
		else GunVolumeBox.Text = _gvLastVol~=nil and tostring(_gvLastVol) or "" end
	end
	gvScan()
end)

RunService.PreRender:Connect(function()
	if not gvActive() then return end
	local v=gvVol(); if not v then return end
	for s,d in pairs(gvData) do
		if not s or not s.Parent then pcall(function() d.conn:Disconnect() end); gvData[s]=nil; continue end
		if s.Volume~=v then s.Volume=v end
	end
end)
gvScan()
